[run]
source = src
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */dashboard.py
    */data_service.py

[report]
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
